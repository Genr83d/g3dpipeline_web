# End-to-end test environment. Contains no real credentials: every value here
# is a placeholder the Firebase emulators accept but never authenticate
# against. `npm run dev:e2e` (and the Playwright webServer) load this file.
#
# VITE_FIREBASE_EMULATORS is the safety switch — the app only ever talks to a
# local emulator when it is exactly "true", so an E2E run cannot reach the
# production project.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

VITE_FIREBASE_API_KEY=e2e-fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=g3d-pipeline-e2e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=g3d-pipeline-e2e
VITE_FIREBASE_STORAGE_BUCKET=g3d-pipeline-e2e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
