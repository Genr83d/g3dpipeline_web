rules_version = '2';

// E2E-ONLY RULESET — NOT THE PRODUCTION RULES.
//
// Production Firestore rules for this project are owned and deployed by the
// Flutter app repository (GENR8-Pipeline / g3d_jobs_list). They are not
// duplicated here, because a second copy would silently drift from the
// deployed one.
//
// The emulator still needs *a* ruleset, so this file grants any signed-in
// emulator user full access. That keeps the E2E suite focused on what it can
// honestly verify — the application's own routing, role gating, and
// service-layer enforcement — instead of re-testing rules it does not own.
//
// Consequence, stated plainly: this suite cannot catch a regression that only
// the deployed rules would reject. See README "End-to-end tests".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
